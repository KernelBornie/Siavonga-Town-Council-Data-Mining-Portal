# Optional: the URL where the app is hosted.
# Used only if a component builds an absolute link.
# Leave unset during local development.
APP_URL=

# Optional: build mode override. Vite defaults to "production"
# during `npm run build`, so you rarely need to set this.
NODE_ENV=production
